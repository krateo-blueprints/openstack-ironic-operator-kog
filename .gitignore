# Lab-specific KubernetesCluster manifests carry Keystone + Redfish
# credentials. Copy the .example.yaml and fill in your own values;
# actual instances stay local.
manifests/kubernetescluster-*.yaml
!manifests/kubernetescluster-*.example.yaml

# HA cluster manifest: carries plaintext Keystone + BMC credentials once filled
# in (the chart bakes ironicAuth.password into CP cloud-init by design).
# Same reason kubernetescluster-ettore-lab.yaml is ignored.
manifests/kubernetescluster-lab-ha.yaml
